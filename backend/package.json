{
  "name": "pspd-backend-microsservicos",
  "version": "1.0.0",
  "description": "Microsserviços gRPC (Authorization, PatientData, DataTransform) do sistema clínico PSPD - HL7/FHIR",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start:auth": "node src/services/authorization/server.js",
    "start:patient": "node src/services/patientData/server.js",
    "start:gateway": "node src/server.js",
    "start:all": "node src/start-all.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "npm test -- --watch"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/env": "^7.0.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/swagger": "^9.8.0",
    "@fastify/swagger-ui": "^6.1.0",
    "@grpc/grpc-js": "^1.10.9",
    "@grpc/proto-loader": "^0.7.13",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
